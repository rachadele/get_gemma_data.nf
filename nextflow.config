
conda.enabled = true

params.gene_mapping = "/space/grp/rschwartz/rschwartz/get_gemma_data.nf/meta/gemma_genes.tsv"
params.study_names = null
params.study_file = null
params.study_paths = null
params.GEMMA_USERNAME = System.getenv('GEMMA_USERNAME')
params.GEMMA_PASSWORD = System.getenv('GEMMA_PASSWORD')
params.author_submitted = false
params.process_samples = false
// this breaks other datasets
// very annoying
// defaults to author-submitted
// use basename so a --study_names path (e.g. study_lists/foo.txt) doesn't nest outdir under its directory
def study_names_base = params.study_names ? new File(params.study_names).name : null
params.outdir = "$projectDir/${study_names_base ?: params.study_file ?: 'output'}_author_${params.author_submitted}_process_samples_${params.process_samples}"
process {
  cache = 'standard'  // Options: 'standard' (default), 'deep', 'lenient', or 'false'
  executor = 'slurm'
  clusterOptions = '-C thrd64 --cpus-per-task=10'
}
 executor {
   queueSize = 90 
 }

nextflow {
  clean {
    afterRun = true  // Default is false; set to true to clean up automatically
  }
}

profiles {
  conda {
    conda.enabled = true
  }

  test {
    params.study_names = null
    params.study_file = 'GSE231868'
    params.study_paths = null
    params.outdir = "$projectDir/test_output"

    process.executor = 'local'
    process.clusterOptions = ''
    process.cpus = 2
    process.memory = '4 GB'

    executor.queueSize = 4

    nextflow.clean.afterRun = false
  }

}